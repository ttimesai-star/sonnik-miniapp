+def webapp_button(chat_id: int, lang: str = "ru") -> None:
+    """Кнопка, открывающая Mini App внутри Telegram (только при SONNIK_WEBAPP_URL)."""
+    en = lang == "en"
+    send(chat_id,
+         "Your dream diary as an app: write a dream, get a reading, see what comes back."
+         if en else
+         "Дневник снов как приложение: записать сон, получить толкование, увидеть, что повторяется.",
+         reply_markup=json.dumps({"inline_keyboard": [[{
+             "text": "Open the diary" if en else "Открыть дневник",
+             "web_app": {"url": WEBAPP_URL}}]]}, ensure_ascii=False))
+
+
+def set_webapp_menu(reset: bool = False) -> bool:
+    """Кнопка меню слева от поля ввода: Mini App или обратно список команд.
+
+    Вызывается только вручную: python bot.py --set-webapp-menu / --reset-menu.
+    """
+    if reset:
+        r = api("setChatMenuButton", menu_button=json.dumps({"type": "commands"}))
+    else:
+        if not WEBAPP_URL:
+            print("SONNIK_WEBAPP_URL не задана (нужен https://...), меню не меняю")
+            return False
+        r = api("setChatMenuButton", menu_button=json.dumps(
+            {"type": "web_app", "text": "Дневник", "web_app": {"url": WEBAPP_URL}},
+            ensure_ascii=False))
+    print("setChatMenuButton", "commands" if reset else WEBAPP_URL, r.get("ok"), r.get("description", ""))
+    return bool(r.get("ok"))
+
